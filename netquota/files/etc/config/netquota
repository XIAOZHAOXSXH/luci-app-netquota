# Capture starts disabled. HTTP is the default; HTTPS is optional with a certificate.
config netquota 'main'
	option enabled '0'
	option portal_mode 'http'
	option guest 'br-guest'
	option guest_address '192.168.9.1'
	option guest_cidr '192.168.9.0/24'
	option management_address '192.168.8.1'
	list egress 'eth0'
	option db_path '/etc/netquota/netquota.db'
	option cert_path '/etc/netquota/tls/cert.pem'
	option key_path '/etc/netquota/tls/key.pem'
	option http_port '2050'
	option https_port '2051'
	option checkpoint_seconds '5'
	option session_timeout_seconds '3600'
	option default_reset_day '1'
	option timezone 'Asia/Shanghai'
