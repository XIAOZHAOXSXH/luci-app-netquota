#!/bin/sh /etc/rc.common
# Install the guest guard before firewall/network startup; preserve it on stop.
START=18
STOP=10
USE_PROCD=1
PROG=/usr/sbin/netquota

start_service() {
	config_load netquota
	local enabled addr http https cert key mode
	config_get_bool enabled main enabled 0
	if [ "$enabled" = 1 ]; then
		"$PROG" --guard || return 1
		/etc/firewall.netquota || return 1
	else
		"$PROG" --cleanup || return 1
	fi
	procd_open_instance daemon
	procd_set_param command "$PROG" daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 15
	procd_close_instance
	[ "$enabled" = 1 ] || return 0
	# Keep the configured portal available while time/offload readiness is pending.
	# The CGI and daemon independently refuse authentication/forwarding until
	# ready. procd retries a listener whose guest address does not exist yet.
	"$PROG" preflight >/dev/null 2>&1 || logger -t netquota 'portal guarded until preflight passes'
	config_get addr main guest_address 192.168.9.1
	config_get http main http_port 2050
	config_get https main https_port 2051
	config_get cert main cert_path /etc/netquota/tls/cert.pem
	config_get key main key_path /etc/netquota/tls/key.pem
	config_get mode main portal_mode http
	if [ "$mode" = http ]; then
		procd_open_instance http-portal
		procd_set_param command /usr/sbin/uhttpd -f -p "$addr:$http" \
			-h /usr/share/netquota/portal -x /cgi-bin -I cgi-bin/entry -E /cgi-bin/entry -S -D -t 15
		procd_set_param respawn 3600 5 0
		procd_set_param stderr 1
		procd_close_instance
		return 0
	fi
	[ -r "$cert" ] && [ -r "$key" ] || return 0
	procd_open_instance http-portal
	procd_set_param command /usr/sbin/uhttpd -f -p "$addr:$http" \
		-h /usr/share/netquota/redirect -x /cgi-bin -I cgi-bin/redirect -E /cgi-bin/redirect -S -D -t 15
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
	procd_open_instance https-portal
	procd_set_param command /usr/sbin/uhttpd -f -s "$addr:$https" -C "$cert" -K "$key" \
		-h /usr/share/netquota/portal -x /cgi-bin -I cgi-bin/entry -E /cgi-bin/entry -S -D -t 15
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
stop_service() {
	NETQUOTA_STOP_PID="$(cat /var/run/netquota.pid 2>/dev/null)"
	case "$NETQUOTA_STOP_PID" in ''|*[!0-9]*) NETQUOTA_STOP_PID= ;; esac
	"$PROG" --guard >/dev/null 2>&1
	# Older versions had no PID file. Their explicit checkpoint is best effort.
	[ -n "$NETQUOTA_STOP_PID" ] || "$PROG" checkpoint >/dev/null 2>&1
}
service_stopped() {
	# rc.common calls this after procd_kill. Wait for the final checkpoint before
	# a new process can clean/rebuild the old process's rules.
	local attempts=0
	while [ -n "$NETQUOTA_STOP_PID" ] && kill -0 "$NETQUOTA_STOP_PID" 2>/dev/null; do
		[ "$attempts" -lt 16 ] || { logger -t netquota 'old daemon has not stopped; guard retained'; return 1; }
		sleep 1
		attempts=$((attempts+1))
	done
	[ "$(uci -q get netquota.main.enabled)" = 1 ] || "$PROG" --cleanup
}
reload_service() { restart; }
service_triggers() { procd_add_reload_trigger netquota; }
